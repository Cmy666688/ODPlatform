# ===== DeepSeek API 配置 =====
# 申请地址：https://platform.deepseek.com/api_keys
# 复制本文件为项目根目录 .env，再填写自己的密钥；.env 已加入 Git 忽略。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# ===== 配置说明 =====
# 系统环境变量优先于 .env。模型可选 deepseek-flash / deepseek-v4-pro。
# 修改 .env 后下次助手请求自动生效，无须重启或中断训练。
# Django + Vue 工作台仍通过 odp-web 启动，计算使用 .odp-meta/web/remote.json 中的远程 GPU。
# 不要将 SSH 密码、真实 API Key 或 .env 内容提交到 Git。
